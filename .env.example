# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# THIS FILE IS COMMITTED. Every value below is a placeholder and must stay one.
# It previously held real Supabase keys; see docs/data-requests/craft-engines.md
# for what to rotate.

# ---------------------------------------------------------------------------
# Database — REQUIRED to run migrations.
# Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the "Direct connection" (port 5432) for migrations, not the pooler (6543):
# the transaction pooler cannot run DDL or hold advisory locks.
#
# This is a connection string, not an access token. A value starting with sbp_
# is a personal access token and will not work here.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:<DB-PASSWORD>@db.<project-ref>.supabase.co:5432/postgres

# ---------------------------------------------------------------------------
# Supabase API — used by the application at runtime, not by migrations.
# SUPABASE_SECRET_KEY bypasses RLS. Server-side only; never NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
# Read server-side only (src/lib/supabase.ts, src/proxy.ts). Deliberately not
# NEXT_PUBLIC_: nothing in the browser uses them, and prefixing would inline the
# project reference into every client bundle. These exact names must match in
# Vercel's environment variables, or createServerClient receives undefined and
# authentication fails at runtime with an unhelpful error.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<redacted>
SUPABASE_SECRET_KEY=sb_secret_<redacted>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# ---------------------------------------------------------------------------
# Craft engines (engines/) — REQUIRED. src/modules/craft/client.ts throws at
# import time without it, so the app will not boot.
#
# The service has no authentication and no RBAC of its own: authorisation
# happens in the Next.js server action before the call. Bind it to loopback or
# a private network, never a public address, and keep this out of NEXT_PUBLIC_.
#
#   local:    cd engines && uvicorn craft.api:app --port 8000
#   container: docker compose up engines
# ---------------------------------------------------------------------------
CRAFT_SERVICE_URL=http://127.0.0.1:8000
CRAFT_SERVICE_TIMEOUT_MS=60000

# Where uploads and engine outputs are kept. The app writes uploads here and
# passes this path to the engines on every call, so both must see the same
# folder. Local: an absolute path such as <repo>/out/storage (out/ is
# gitignored). Container: the volume mounted at /data (compose.yaml).
CRAFT_STORAGE_ROOT=

# ---------------------------------------------------------------------------
# AI spec reading (engines/craft/review/ai.py). Read by the ENGINE service, not
# by Next.js. Optional: unset or 'none' means only the rule reader runs.
# The model runs on SPI's own server (Ollama), so specs do not leave it.
#   SPI_AI_PROVIDER=ollama
#   SPI_AI_URL=http://127.0.0.1:11434
#   SPI_AI_MODEL=qwen3:8b          # development laptop; a server: qwen3.8:27b
# ---------------------------------------------------------------------------
SPI_AI_PROVIDER=
SPI_AI_URL=
SPI_AI_MODEL=
