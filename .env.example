# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Database
#
# Migrations are applied through the Supabase MCP connector, so DATABASE_URL is
# only needed for direct psql access or for running ./scripts/migrate.sh
# against a database by hand.
#
# Supabase dashboard -> Project Settings -> Database -> Connection string -> URI
# Use the DIRECT connection (port 5432). The 6543 transaction pooler cannot run
# DDL. The password shown as [YOUR-PASSWORD] is a placeholder — substitute the
# real database password, which is separate from your Supabase account login
# and from the API keys below.
# ---------------------------------------------------------------------------
DATABASE_URL=

# Local Postgres used to validate migrations before they reach Supabase.
LOCAL_DATABASE_URL=postgresql://localhost:5432/spi_validate

# ---------------------------------------------------------------------------
# Supabase API — used by the application at runtime, not by migrations.
# Project: SmartPage Intelligence (tyioiiszcftkaayhlsac), region ap-south-1
# ---------------------------------------------------------------------------
SUPABASE_URL=https://tyioiiszcftkaayhlsac.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_JkIR77ca5Uu_d-bZF4Kb7A_XvC7FFj3
SUPABASE_JWKS_URL=https://tyioiiszcftkaayhlsac.supabase.co/auth/v1/.well-known/jwks.json

# Server-side only. Dashboard -> Project Settings -> API keys -> secret key.
# Never expose this to browser code (spec 22).
SUPABASE_SECRET_KEY=
