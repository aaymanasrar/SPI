# Copy to .env and fill in. .env is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Database — REQUIRED to run migrations.
# Supabase dashboard → Project Settings → Database → Connection string → URI
# Use the "Direct connection" (port 5432) for migrations, not the pooler (6543):
# the transaction pooler cannot run DDL or hold advisory locks.
# Format:
#   postgresql://postgres:<DB-PASSWORD>@db.<project-ref>.supabase.co:5432/postgres
# ---------------------------------------------------------------------------
DATABASE_URL=

# ---------------------------------------------------------------------------
# Supabase API — used by the application at runtime, not by migrations.
